# Copy to /etc/mass-poll.env (chmod 600, owned by root) and fill in IP_SALT.
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
# Behind Caddy/nginx on this machine: read the client IP from X-Forwarded-For.
TRUST_PROXY=1
# Long random string, e.g.:  openssl rand -hex 32   (never reuse the default)
IP_SALT=
DB_PATH=/var/lib/mass-poll/mass-poll.db
